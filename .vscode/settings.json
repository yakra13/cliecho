{
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    // "editor.detectIndentation": false,
	"[yaml]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced"
	},
    "files.eol": "\n",
    "yaml.schemas": {
        "./.schemas/rules.json": ["*.rule"],
        "./.schemas/tools.json": ["modules_working/*/src/*/config.yml"]
    },
    "yaml.customTags": [
        "!secret scalar",
        "!include scalar"
    ],
    "files.associations": {
        "*.rule": "yaml",
        "*.config": "ini"
    }
}